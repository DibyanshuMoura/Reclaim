{
  "name": "reclaim",
  "version": "0.1.0",
  "private": true,
  "description": "Reclaim — anonymous lost-and-found item recovery with AI-extracted matching",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "jest --runInBand",
    "e2e": "node scripts/ui-e2e.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/env.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "mongoose": "^9.11.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1"
  }
}
