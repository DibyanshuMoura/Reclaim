# Copy this file to .env and fill in real values.
# Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB connection string (include a database name, e.g. ...mongodb.net/reclaim)
MONGODB_URI=

# Google Gemini vision API (https://aistudio.google.com/apikey)
# Model must support image input + structured output.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Public base URL the FRONTEND is served from — the URL users open and the
# one embedded in emails (private report and match links). In the single-app
# mode this is the server's own origin; with the frontend split onto another
# host (e.g. Vercel), set it to that frontend origin:
APP_BASE_URL=http://localhost:5000

# CORS: enter the frontend origin when the frontend is deployed separately
# (comma-separated for multiple). In the single-app mode no value is needed
# because the API is used same-origin:
# APP_CORS_ORIGINS=https://your-frontend.vercel.app

# Optional: number of reverse-proxy hops in front of the server (TRUST_PROXY=1
# behind exactly one nginx / Render / Railway proxy). Recovers real client IPs
# so per-IP rate limits count correctly. Leave unset when the Node process is
# exposed directly; a spoofable X-Forwarded-For must never be trusted then.
# TRUST_PROXY=1

# Per-IP rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
REPORT_RATE_LIMIT_MAX=10

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Image handling (AGENT.md §5)
MAX_IMAGE_BYTES=5242880
IMAGE_RETENTION_HOURS=24
IMAGE_MAX_WIDTH_PX=1280

# AI analysis (AGENT.md §6, §9)
AI_MAX_ATTEMPTS=3
AI_JOB_TIMEOUT_MS=120000
# Optional: stale "processing" lease recovery window (default 3x AI_JOB_TIMEOUT_MS)
# AI_JOB_STALE_MS=360000
# Optional: worker poll interval (default 5000)
# ANALYSIS_WORKER_INTERVAL_MS=5000

# Matching (AGENT.md §8)
MATCH_NOTIFY_THRESHOLD=55
# Optional tuning; each factor weight is 0..1, normalized internally.
# MATCH_WEIGHT_CATEGORY=0.3
# MATCH_WEIGHT_COLORS=0.2
# MATCH_WEIGHT_BRAND=0.1
# MATCH_WEIGHT_TEXT=0.2
# MATCH_WEIGHT_VENUE=0.1
# MATCH_WEIGHT_TIME=0.1

# Email notifications (AGENT.md §2, §9)
# Requires real SMTP credentials; leave disabled until configured. For Gmail:
# port 465 with EMAIL_SECURE=true and an app password.
EMAIL_ENABLED=false
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM="Reclaim <your-address@example.com>"
# EMAIL_MAX_ATTEMPTS=5
